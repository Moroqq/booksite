# CRM интеграция
CRM_WEBHOOK_URL=

# Email (Resend, SendGrid, Nodemailer)
EMAIL_FROM=
EMAIL_TO=
RESEND_API_KEY=

# Оплата книги обрабатывается вручную по QR/банковскому переводу.
# Внешний эквайринг и ключи платёжных сервисов не используются.

# Analytics
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=

# Админка (локальный вход; не размещайте эти значения публично)
ADMIN_PASSWORD=change-this-local-password
ADMIN_SECRET=replace-with-a-long-random-local-secret

# Домен, на котором открывается админка (отдельно от основного сайта).
# Локально: admin.localhost (пропишите 127.0.0.1 admin.localhost в /etc/hosts).
# В проде: admin.вашдомен.ру — DNS должен указывать на тот же сервер.
ADMIN_HOSTNAME=admin.localhost

# Вход покупателей через российские сервисы.
# VK ID: кабинет разработчика id.vk.com/about/business — нужен только ID приложения.
# Яндекс ID: oauth.yandex.ru — нужны ID и секрет приложения.
# Пока значения пустые, вход не обязателен и заказ оформляется как раньше.
VK_CLIENT_ID=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Адрес сайта — нужен, чтобы сервисы входа вернули пользователя обратно.
# Локально: http://localhost:3010, в проде: https://zvukterap.ru
SITE_ORIGIN=http://localhost:3010
